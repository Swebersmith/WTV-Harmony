{
  "module": {
    "name":"entry","type":"entry","mainElement":"EntryAbility","description":"$string:module_desc",
    "deviceTypes":["phone","tablet"],"deliveryWithInstall":true,"installationFree":false,
    "pages":"$profile:main_pages",
    "requestPermissions":[{"name":"ohos.permission.INTERNET"},{"name":"ohos.permission.GET_NETWORK_INFO"},{"name":"ohos.permission.KEEP_BACKGROUND_RUNNING"}],
    "abilities":[{
      "name":"EntryAbility","srcEntry":"./ets/entryability/EntryAbility.ets",
      "backgroundModes":["audioPlayback"],
      "description":"$string:app_name","icon":"$media:app_icon_layered","label":"$string:app_name",
      "startWindowIcon":"$media:app_icon","startWindowBackground":"$color:start_window_background","exported":true,
      "skills":[
        {"entities":["entity.system.home"],"actions":["ohos.want.action.home"]},
        {"actions":["ohos.want.action.sendData"],"uris":[{"type":"text/plain"}]}
      ]
    }]
  }
}
